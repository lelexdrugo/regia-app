{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moviola-bench",
  "version": "0.0.1",
  "identifier": "dev.regia.moviola-bench",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "moviola renderer benchmark",
        "width": 1280,
        "height": 760,
        "resizable": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
